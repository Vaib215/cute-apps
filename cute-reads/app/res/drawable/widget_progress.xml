<?xml version="1.0" encoding="utf-8"?>
<!-- A rounded bar: grey track, peach progress. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#FF3A3A3C" /><corners android:radius="3dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="#FFFFE3D3" /><corners android:radius="3dp" /></shape></clip>
    </item>
</layer-list>
