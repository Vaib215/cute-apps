<?xml version="1.0" encoding="utf-8"?>
<!-- The digital clock, stacked: hours over minutes. The text sizes itself to fill the widget, whatever its
     shape; the colours come from spans in the time format (see SleepWidget.Digital). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:padding="8dp">
    <TextClock
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoSizeMaxTextSize="600sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/fredoka_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.8"
        android:maxLines="2"
        android:shadowColor="#55000000"
        android:shadowRadius="10"
        android:textColor="#FFFFE3D3" />
</FrameLayout>
