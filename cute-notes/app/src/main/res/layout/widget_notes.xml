<?xml version="1.0" encoding="utf-8"?>
<!-- The latest note (tap to open it) and a Write button for a new one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Latest note"
            android:textColor="#FF8E8E93"
            android:textSize="13sp" />
        <LinearLayout
            android:id="@+id/write"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Write"
                android:src="@drawable/ic_edit_dark" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="Write"
                android:textColor="#FF3B2F2C"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFE6E6E6"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="4"
        android:textColor="#FF8E8E93"
        android:textSize="14sp" />
</LinearLayout>
